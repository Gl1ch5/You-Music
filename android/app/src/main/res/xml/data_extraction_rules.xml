<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: the same set for cloud backup and device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="kv.xml" />
        <include domain="file" path="features.json" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="kv.xml" />
        <include domain="file" path="features.json" />
    </device-transfer>
</data-extraction-rules>
