<?xml version="1.0" encoding="utf-8"?>
<!-- Plain HTTP is allowed because users point the app at their own AI endpoints and proxies, which often have no TLS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
