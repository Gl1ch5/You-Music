[Unit]
Description=You Music server (account, sync, AI, proxy)
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/opt/youmusic-server/.env
ExecStart=/usr/bin/node /opt/youmusic-server/index.mjs
WorkingDirectory=/opt/youmusic-server
DynamicUser=yes
StateDirectory=youmusic-server
Restart=always
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
