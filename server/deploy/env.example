# Copy to /opt/youmusic-server/.env (chmod 600). Never commit the real file.
PORT=8740
HOST=127.0.0.1
BASE_PATH=/youmusic
DATA_DIR=/var/lib/youmusic-server
# OpenAI-compatible upstream for the 50-per-day AI recommendations.
AI_BASE_URL=http://127.0.0.1:20128/v1
AI_API_KEY=
AI_MODEL=
AI_DAILY_LIMIT=50
# Free proxy for signed-in users (HTTP CONNECT). Empty PROXY_PUBLIC_HOST turns it off.
PROXY_PUBLIC_HOST=
PROXY_PORT=20140
PROXY_MAX_CONNECTIONS=48
# The server's own public IPs: the proxy refuses to connect back to them.
SELF_IPS=
